    { "id": "op-mainnet", "ref": "codex/bridge-evm-nets-r17-20261117", "fallbackRefs": ["codex/bridge-evm-nets-r16b-20261117"], "path": "deployments/op-mainnet/bridge.network.json" },
    { "id": "linea", "ref": "codex/bridge-evm-nets-r17-20261117", "fallbackRefs": ["codex/bridge-evm-nets-r16b-20261117"], "path": "deployments/linea/bridge.network.json" },
    { "id": "base", "ref": "codex/bridge-evm-nets-r17-20261117", "fallbackRefs": ["codex/bridge-evm-nets-r16b-20261117"], "path": "deployments/base/bridge.network.json" },
    { "id": "bnb", "ref": "codex/bridge-evm-nets-r17-20261117", "fallbackRefs": ["codex/bridge-evm-nets-r16b-20261117"], "path": "deployments/bnb/bridge.network.json" },
