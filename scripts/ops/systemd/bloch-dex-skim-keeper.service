[Unit]
Description=One pass of the permissionless postern-dex skim keeper
After=network-online.target

[Service]
Type=oneshot
User=bloch-dex-ops
EnvironmentFile=/etc/bloch-dex-ops/env
StateDirectory=bloch-dex-keeper
StateDirectoryMode=0700
ExecStart=/usr/bin/env node ${DEX_OPS_ROOT}/scripts/ops/dex-skim-keeper.mjs --config ${DEX_GATE} --rpc ${DEX_RPC} --keeper ${DEX_KEEPER} --state /var/lib/bloch-dex-keeper/state.json --execute -- --keystore ${DEX_KEEPER_KEYSTORE} --password-file ${DEX_KEEPER_PASSWORD_FILE}
SuccessExitStatus=0 1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
