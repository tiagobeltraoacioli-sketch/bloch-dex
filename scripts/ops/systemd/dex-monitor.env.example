# Values marked TBD-owner must be filled before the units start.
DEX_OPS_ROOT=/opt/bloch/postern-dex
DEX_GATE=/etc/bloch-dex-ops/finality-gate.mainnet.json
DEX_SAFE_PLAN=/etc/bloch-dex-ops/safe.plan.json
# The bUSDC token's own deployment files, copied from the bridge deployment (deploy_pontes.py plan --write and
# record --write), never typed by hand: the gate checks the token's signers, guardians and T against them.
DEX_BUSDC_BRIDGE_PLAN=/etc/bloch-dex-ops/busdc.plan.json
DEX_BUSDC_BRIDGE_RECORD=/etc/bloch-dex-ops/busdc.record.json
DEX_RPC=http://127.0.0.1:18955
# bUSDC exit status (held = CRIT): an Ethereum mainnet RPC with a finalized tag, and the ProvenanceSourceVault.
DEX_ETH_RPC=TBD-owner
DEX_BUSDC_VAULT=TBD-owner
DEX_LP_RECIPIENT=TBD-owner
# The LP recipient's floor in shares (opening form, seederExit). 0 means no floor: the owner allows a full exit.
DEX_LP_MIN_SHARES=TBD-owner
DEX_KEEPER=TBD-owner
DEX_KEEPER_KEYSTORE=TBD-owner
DEX_KEEPER_PASSWORD_FILE=TBD-owner
# The keeper's rolling 24 h limits (opening form, keeper.budgetWei and keeper.maxTx; decided: 0.05 BLCH, 48).
# The keeper unit and the monitor's keeper_budget check both read them.
DEX_KEEPER_BUDGET_WEI=50000000000000000
DEX_KEEPER_MAX_TX=48
