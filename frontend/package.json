{
  "name": "@postern/dex-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:multichain": "tsc --noEmit && vite build --config vite.multichain.config.ts && node scripts/multichain-finish.mjs",
    "build:mobile-hotfix": "vite build --config vite.mobile.config.ts && node scripts/package-mobile-hotfix.mjs",
    "test:mobile-edge": "node --test edge/worker.check.mjs",
    "test:qr-release": "node --test qr-release/worker.check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:bundle": "node scripts/check-production-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json README.md",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@reown/appkit": "1.8.23",
    "@walletconnect/sign-client": "2.25.0",
    "lucide-react": "1.43.0",
    "qr": "0.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
