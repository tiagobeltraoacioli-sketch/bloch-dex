[Unit]
Description=Atomic full-state checkpoint for Bloch DEX experimental testnet
Requires=bloch-dex-anvil-v2.service
After=bloch-dex-anvil-v2.service

[Service]
Type=oneshot
User=bloch-dex-dev
Group=bloch-dex-dev
ExecStart=/usr/bin/python3 /opt/bloch-dex-devnet/ops/atomic_anvil_checkpoint.py --state /var/lib/bloch-dex-devnet-v2/state.json
TimeoutStartSec=90
MemoryMax=512M
CPUQuota=25%
TasksMax=4
LimitNOFILE=64
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/bloch-dex-devnet-v2

